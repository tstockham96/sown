{
  "name": "sown",
  "version": "1.0.0",
  "description": "FOURS: a daily number puzzle. Drag a tile to spread its number across the line, +1 each. Any tile that hits exactly 4 clears.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode single",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/play.mjs",
    "audit": "tsx scripts/audit.ts",
    "par": "tsx scripts/par.ts",
    "e2e": "node scripts/play.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0"
  }
}
